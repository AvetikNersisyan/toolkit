# PostgreSQL connection
DATABASE_URL=postgres://user:password@localhost:5432/tools_landing

# Where admin uploads (product photos, videos) are stored. Defaults to ./uploads.
# In production use a folder outside the repo, e.g. /var/www/toolkit-uploads.
UPLOAD_DIR=

# Orders admin at /admin (HTTP Basic Auth). Admin is disabled if either is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Telegram alert for every new order (see DEPLOY.md). Leave empty to turn alerts off.
# TELEGRAM_CHAT_ID can list several chats, comma-separated (group ids start with -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to turn GA off.
# Like every NEXT_PUBLIC_ value it is baked in at build time: rebuild after changing it.
NEXT_PUBLIC_GA_ID=

# Meta Pixel — leave empty until you create the pixel in Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Event sent when an order is placed: Purchase (default) or Lead.
NEXT_PUBLIC_META_ORDER_EVENT=Purchase

# Meta Conversions API (server-side events). Optional but recommended.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Set while testing in Events Manager → Test events, then remove.
META_TEST_EVENT_CODE=
