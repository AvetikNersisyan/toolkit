# PostgreSQL connection
DATABASE_URL=postgres://user:password@localhost:5432/tools_landing

# Orders admin at /admin (HTTP Basic Auth). Admin is disabled if either is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Meta Pixel — leave empty until you create the pixel in Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
# Event sent when an order is placed: Purchase (default) or Lead.
NEXT_PUBLIC_META_ORDER_EVENT=Purchase

# Meta Conversions API (server-side events). Optional but recommended.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Set while testing in Events Manager → Test events, then remove.
META_TEST_EVENT_CODE=
